{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/collect.js": {
      "maxDuration": 120
    },
    "api/apify-usage.js": {
      "maxDuration": 30
    },
    "api/pipeline.js": {
      "maxDuration": 120
    }
  },
  "git": {
    "deploymentEnabled": {
      "probe-results": false
    }
  },
  "rewrites": [
    {
      "source": "/api/probe-free",
      "destination": "/api/health?probe=1"
    }
  ],
  "crons": [
    {
      "path": "/api/pipeline?op=tick",
      "schedule": "10 18 * * *"
    }
  ]
}
